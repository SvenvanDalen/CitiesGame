<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Testcode onder Cities/Assets/Tests als apart project, zodat SonarQube productie- en testcode
    uit elkaar houdt. Unity levert zijn eigen NUnit 3.x mee; hier draait de NuGet-versie.
    CI voert de EditMode-tests die geen Unity-runtime nodig hebben uit met dotnet test en meet de dekking.
  -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <IsTestProject>true</IsTestProject>
    <RollForward>Major</RollForward>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants>$(DefineConstants);UNITY_EDITOR;UNITY_INCLUDE_TESTS;UNITY_6000_0_OR_NEWER</DefineConstants>
    <UnityManaged Condition="'$(UnityManaged)' == ''">/opt/unity/Editor/Data/Managed</UnityManaged>
    <UnityProject>$(MSBuildThisFileDirectory)../../../Cities</UnityProject>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(UnityProject)/Assets/Tests/**/*.cs" />
    <Compile Include="Shims/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Cities.Sonar/Cities.Sonar.csproj" />
    <Reference Include="$(UnityManaged)/UnityEngine/*.dll" Private="true" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
  </ItemGroup>
</Project>
