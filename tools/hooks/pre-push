#!/bin/sh
# Draait de snelle tests (zonder Unity, zoals CI) voor elke push. Overslaan: git push --no-verify,
# of CITIES_SKIP_TESTS=1 in de omgeving. Installeren: tools/install-hooks.ps1.
if [ "${CITIES_SKIP_TESTS:-0}" = "1" ]; then
  echo "pre-push: tests overgeslagen (CITIES_SKIP_TESTS=1)"
  exit 0
fi

root="$(git rev-parse --show-toplevel)"
if command -v pwsh >/dev/null 2>&1; then
  shell=pwsh
elif command -v powershell.exe >/dev/null 2>&1; then
  shell=powershell.exe
else
  echo "pre-push: PowerShell niet gevonden; tests overgeslagen" >&2
  exit 0
fi

"$shell" -NoProfile -ExecutionPolicy Bypass -File "$root/tools/test.ps1" -Suite Fast
status=$?
if [ $status -ne 0 ]; then
  echo "pre-push: snelle tests mislukt (code $status); push afgebroken. Overslaan met git push --no-verify." >&2
fi
exit $status
